    "@tiendanube/nube-sdk-types": "^0.81.0",
    "@tiendanube/nube-sdk-ui": "^0.19.0",
    "concurrently": "^9.1.2",
    "serve": "^14.2.4",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  }
}
