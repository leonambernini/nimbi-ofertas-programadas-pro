# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase Postgres (Prisma) — obrigatório
# Use Session pooler (não db.*.supabase.co se a rede não tem IPv6).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase API (Storage / CDN)
SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=ofertas-pro

# Nuvemshop App (Partner Portal)
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
NEXT_PUBLIC_NUVEMSHOP_CLIENT_ID=

# Host OAuth: tiendanube (default LATAM) | nuvemshop (BR)
# NUVEMSHOP_AUTH_HOST=nuvemshop

# Escopos sugeridos:
#   write_products, write_content, write_scripts
#
# URLs no Partner Portal:
#   Redirect (callback):     {APP_URL}/api/auth/nuvemshop/callback
#   URL do app (Enhanced):   {APP_URL}/offers
#   Preferences URL:         {APP_URL}/offers
#   Store Redact webhook:         {APP_URL}/api/v1/webhooks/redact/store
#   Customer Redact webhook:      {APP_URL}/api/v1/webhooks/redact/customers
#   Customers Data Request:       {APP_URL}/api/v1/webhooks/redact/customers/data-request

NUVEMSHOP_WEBHOOK_SECRET=

# Billing nativo
NUVEMSHOP_SERVICE_ID=
NUVEMSHOP_BILLING_CONCEPT_CODE=app-cost
BILLING_PLAN_ID=
BILLING_PLAN_EXTERNAL_REF=ofertas-pro-mensal
BILLING_AMOUNT_VALUE=29.90
BILLING_AMOUNT_CURRENCY=BRL
# Dev: gate desligado automaticamente (NODE_ENV=development).
# Produção: gate ligado. Override: BILLING_ENFORCE=true|false
# BILLING_ENFORCE=false

# Cron Vercel (Authorization: Bearer …)
CRON_SECRET=

# Criptografia do access_token no banco
TOKEN_ENCRYPTION_KEY=

# Dev local: store_id já instalada no banco (pula JWT do Nexo)
# DEV_STORE_ID=
